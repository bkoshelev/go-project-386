{
  "name": "calendar-booking-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsp compile .",
    "generate": "pnpm build && openapi-ts",
    "check": "tsp format --check \"**/*.tsp\" && tsp compile . --no-emit",
    "format": "tsp format \"**/*.tsp\""
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2"
}
