#!/usr/bin/env bash
#MISE description="Установить закреплённые инструменты, подготовить и проверить worktree (из scripts/setup-worktree.sh: основной сценарий)"
# Завершаем скрипт при ошибках команд, необъявленных переменных и сбоях конвейеров.
set -euo pipefail
# Переходим в корень текущего проекта.
cd "$MISE_PROJECT_ROOT"
# При ошибке выводим номер строки и завершаем скрипт с исходным кодом возврата.
trap 'status=$?; echo "[setup] Failed at line $LINENO (exit $status)" >&2; exit "$status"' ERR
# Разрешаем только значения 0 и 1 для режима дополнительных проверок.
case "${SETUP_VERIFY:-0}" in 0|1) ;; *) echo 'SETUP_VERIFY must be 0 or 1' >&2; exit 1 ;; esac
# Выбираем ветку проверки по операционной системе и архитектуре процессора.
case "$(uname -s)/$(uname -m)" in
  # Разрешаем поддерживаемые сочетания macOS и Linux/WSL на amd64 и arm64.
  Darwin/x86_64|Darwin/arm64|Linux/x86_64|Linux/amd64|Linux/arm64|Linux/aarch64) ;;
  # Для остальных платформ сообщаем об ограничении и завершаем подготовку с ошибкой.
  *) echo 'Supported platforms: macOS, Linux or WSL on amd64/arm64' >&2; exit 1 ;;
# Завершаем выбор поддерживаемой платформы.
esac
# Отключаем автоматические hooks: подготовку запускаем явно, чтобы её ошибки прерывали setup.
export MISE_NO_HOOKS=1
# Устанавливаем только инструменты проекта, исключая инструменты родительских конфигураций.
mise install go node pnpm golangci-lint go:golang.org/x/vuln/cmd/govulncheck sqlc hk pitchfork rust conda:postgresql
# Запускаем подготовку через mise, чтобы PATH включал только что установленные инструменты.
mise run setup:prepare
# Проверяем доступность инструментов, согласованность версий и готовность Git hook.
mise run doctor
# Проверяем, запросил ли пользователь полный набор проверок приложения.
if [[ "${SETUP_VERIFY:-0}" == 1 ]]; then
  # Выполняем общий набор проверок backend и frontend.
  mise run check
# Завершаем условный запуск дополнительных проверок.
fi
# Сообщаем об успешной подготовке рабочего пространства.
echo '[setup] Workspace setup complete'
