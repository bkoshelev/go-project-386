#!/usr/bin/env bash
#MISE description="Проверить форматирование, импорты и линтеры backend без изменения файлов (из Makefile: lint)"
# Завершаем скрипт при ошибках команд, необъявленных переменных и сбоях конвейеров.
set -euo pipefail
# Переходим в каталог серверного Go-модуля текущего проекта.
cd "$MISE_PROJECT_ROOT/backend"
# Проверяем соответствие конфигурации golangci-lint его схеме.
golangci-lint config verify
# Создаём временный файл для изменений, предложенных форматтером.
diff_file=$(mktemp)
# Удаляем временный файл при любом завершении скрипта.
trap 'rm -f "$diff_file"' EXIT
# Начальное значение означает успешное выполнение форматтера.
status=0
# Сохраняем предлагаемые изменения и код ошибки, не изменяя исходники.
golangci-lint fmt --diff > "$diff_file" || status=$?
# Проверяем, предложил ли форматтер изменения.
if [[ -s "$diff_file" ]]; then
  # Выводим различия между исходниками и ожидаемым форматированием.
  cat "$diff_file"
  # Подсказываем команду для явного применения форматирования.
  echo 'Formatting differs; run mise run backend:fmt' >&2
  # Завершаем проверку с ошибкой при обнаружении различий.
  exit 1
# Завершаем ветку обработки различий форматирования.
fi
# При сбое форматтера без различий возвращаем его код ошибки.
[[ "$status" == 0 ]] || exit "$status"
# Запускаем настроенные линтеры без автоматических исправлений.
golangci-lint run
