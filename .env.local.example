# Необязательные настройки текущего worktree. Скопируйте в .env.local.
# Адрес HTTP-сервера; для параллельного worktree выберите свободный порт.
HTTP_ADDR=127.0.0.1:8080

# Обязателен для запуска HTTP-сервера; также используется командами миграций.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/calendar_test?sslmode=disable

# SETUP_VERIFY=1 запускает проверки backend и frontend после подготовки.
# SETUP_VERIFY=1
