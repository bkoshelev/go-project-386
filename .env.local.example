# Необязательные настройки только текущего worktree. Загружает mise.
# Dev-daemons сами задают PORT, VITE_BACKEND_URL и DATABASE_URL.
# Для ручной работы с внешней БД (переопределяет dev preset!):
# Для прямого запуска сервера также задайте:
# PORT=8080
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/calendar?sslmode=disable
# SETUP_VERIFY=1
