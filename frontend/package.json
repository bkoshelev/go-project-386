{
  "name": "calendar-booking-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "pnpm --dir ../api generate",
    "dev": "pnpm api:generate && vite",
    "build": "pnpm api:generate && tsc -b && vite build",
    "check": "pnpm --dir ../api check && pnpm api:generate && pnpm lint && pnpm format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm lint:code && pnpm lint:css",
    "lint:code": "oxlint .",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:fix": "oxlint . --fix && stylelint \"**/*.css\" --fix --max-warnings 0",
    "preview": "vite preview",
    "test:smoke": "pnpm build && playwright test"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@xstate/react": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2"
}
